# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# System files
.DS_Store
*.pem

# Python (backend/)
__pycache__/
*.pyc
venv/
.venv/
backend/pgdata_5433/

# Raw MongoDB dumps (real user PII) — never commit backup archives, only the
# README documenting how to (re)produce them.
backend/backups/*
!backend/backups/README.md

# Secrets and credentials
*token.json*
*credentials.json*
credentials.json
.credentials
.env
.env.*
*.env
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
dump.rdb

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development (Android SDK tooling; flutter_app/ has its own
# .gitignore for Flutter-specific build artifacts)
android-sdk/

memory/test_credentials.md
